{
  "name": "chancms",
  "type": "module",
  "version": "3.6.8",
  "private": true,
  "description": "ChanCMS 现代化CMS系统",
  "main": "app.js",
  "scripts": {
    "dev": "node --env-file=env/mysql.dev --watch app.js",
    "local:prd": "node --env-file=env/mysql.prd --watch app.js",
    "prd": "pm2 start pm2/mysql.json",
    "dev:admin": "corepack pnpm --filter chancms-admin dev",
    "dev:user": "corepack pnpm --filter cms-member dev",
    "build": "corepack pnpm build:admin && corepack pnpm build:user",
    "build:admin": "corepack pnpm --filter chancms-admin build && node scripts/sync-dist.mjs admin",
    "build:user": "corepack pnpm --filter cms-member build && node scripts/sync-dist.mjs user",
    "sync:admin": "node scripts/sync-dist.mjs admin",
    "sync:user": "node scripts/sync-dist.mjs user"
  },
  "keywords": [
    "cms"
  ],
  "author": "明空",
  "license": "Apache-2.0",
  "dependencies": {
    "adm-zip": "^0.6.1",
    "bcrypt": "^6.0.0",
    "chanjs": "2.8.12",
    "mysql2": "^3.24.4",
    "dayjs": "^1.11.23",
    "iconv-lite": "^0.7.3",
    "ip2region": "^2.3.0",
    "marked": "^18.1.1",
    "multer": "^2.4.0",
    "nodemailer": "^10.0.10",
    "pino-pretty": "^13.1.3",
    "svg-captcha": "^1.4.0",
    "xml2js": "^0.6.2",
    "xss": "^1.0.15",
    "zod": "^4.6.5"
  },
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=22.18"
  }
}
